@baseUrl = http://localhost:3000

# Run the requests from top to bottom.
# Request 1 creates a todo, and later requests use its id.
# The todo is deleted only at the end (requests 25-26).
# Request 24 needs the file tests/large-body.json (see README).

### ===== HAPPY PATHS =====

### 1. Create a todo => 201
# @name created
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "Write API documentation",
  "description": "OpenAPI + README examples",
  "state": "todo",
  "dueDate": "2026-12-31"
}

### id of the todo created above
@id = {{created.response.body.id}}

### 2. Create a todo with only title (state defaults to todo) => 201
POST {{baseUrl}}/todos
Content-Type: application/json

{ "title": "Buy groceries" }

### 3. Get all todos => 200
GET {{baseUrl}}/todos

### 4. Filter by state => 200
GET {{baseUrl}}/todos?state=todo

### 5. Get a single todo => 200
GET {{baseUrl}}/todos/{{id}}

### 6. Update a todo => 200
PUT {{baseUrl}}/todos/{{id}}
Content-Type: application/json

{ "state": "doing" }


### ===== CLIENT ERRORS =====

### 7. POST malformed JSON => 400
POST {{baseUrl}}/todos
Content-Type: application/json

{ "title": "Missing brace"

### 8. POST without title => 400
POST {{baseUrl}}/todos
Content-Type: application/json

{ "description": "No title" }

### 9. POST with blank title => 400
POST {{baseUrl}}/todos
Content-Type: application/json

{ "title": "   " }

### 10. POST with invalid description type => 400
POST {{baseUrl}}/todos
Content-Type: application/json

{ "title": "Test", "description": 123 }

### 11. POST with invalid state => 400
POST {{baseUrl}}/todos
Content-Type: application/json

{ "title": "Test", "state": "finished" }

### 12. POST with invalid dueDate text => 400
POST {{baseUrl}}/todos
Content-Type: application/json

{ "title": "Test", "dueDate": "abc" }

### 13. POST with impossible dueDate (February 30) => 400
POST {{baseUrl}}/todos
Content-Type: application/json

{ "title": "Test", "dueDate": "2026-02-30" }

### 14. POST with dueDate that is not a string => 400
POST {{baseUrl}}/todos
Content-Type: application/json

{ "title": "Test", "dueDate": false }

### 15. GET with invalid state filter => 400
GET {{baseUrl}}/todos?state=finished

### 16. GET with empty state filter => 400
GET {{baseUrl}}/todos?state=

### 17. GET todo that does not exist => 404
GET {{baseUrl}}/todos/1000

### 18. PUT with invalid state => 400
PUT {{baseUrl}}/todos/{{id}}
Content-Type: application/json

{ "state": "finished" }

### 19. PUT with invalid dueDate => 400
PUT {{baseUrl}}/todos/{{id}}
Content-Type: application/json

{ "dueDate": 0 }

### 20. PUT with array body => 400
PUT {{baseUrl}}/todos/{{id}}
Content-Type: application/json

[]

### 21. PUT todo that does not exist => 404
PUT {{baseUrl}}/todos/1000
Content-Type: application/json

{ "state": "doing" }


### 22. POST with unsupported charset => 415
POST {{baseUrl}}/todos
Content-Type: application/json; charset=latin1

{ "title": "Test" }

### 23. POST with unsupported content encoding => 415
POST {{baseUrl}}/todos
Content-Type: application/json
Content-Encoding: compress

{ "title": "Test" }

### 24. POST with too large body (over 100 kB) => 413
POST {{baseUrl}}/todos
Content-Type: application/json

< ./tests/large-body.json


### ===== DELETE =====

### 25. Delete the todo => 204
DELETE {{baseUrl}}/todos/{{id}}

### 26. Delete the same todo again => 404
DELETE {{baseUrl}}/todos/{{id}}
